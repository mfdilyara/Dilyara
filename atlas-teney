::selection{background:#bfa071;color:#0f1116}
a{color:var(--gold)}button,input{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.43}
button:focus-visible,input:focus-visible,a:focus-visible{outline:2px solid var(--gold);outline-offset:4px}
.wrap{position:relative;z-index:1;max-width:1040px;margin:auto;padding:24px 20px 85px}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:4px 0 18px;border-bottom:1px solid var(--line)}
