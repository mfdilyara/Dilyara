.progress span{background:#63574947;height:3px;border-radius:5px;transition:background .2s}
.progress span.done{background:var(--gold)}
.content{padding:clamp(22px,4vw,35px);position:relative;animation:appear .28s ease both}
@keyframes appear{from{opacity:.4;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.kicker{display:inline-flex;align-items:center;gap:8px;font-size:10px;text-transform:uppercase;letter-spacing:.2em;color:var(--gold);font-weight:750;margin:0 0 7px}
.kicker:before{content:"◆";font-size:8px}
h2{font:normal clamp(28px,3vw,38px)/1.16 Georgia,"Times New Roman",serif;letter-spacing:-.015em;margin:8px 0 19px}
h3{font:normal 22px/1.2 Georgia,"Times New Roman",serif;color:var(--warm);margin:0 0 12px}
.lead{font:normal clamp(18px,2.3vw,22px)/1.5 Georgia,"Times New Roman",serif;color:#e7d7bd}
p{margin:0 0 17px}.muted{color:var(--muted)}.riddle{font-size:14px;line-height:1.83;color:#d7d0c3}
.statement{margin:20px 0;padding:14px 18px;border-left:2px solid var(--gold);background:#b88b4b09;font:normal 19px/1.45 Georgia,serif;color:#efd8a9}
.clue{margin:13px 0;padding:19px 19px 15px;border:1px solid #b5986b3a;border-radius:12px;background:#ffffff05}
.clue .num{font-size:9px;letter-spacing:.19em;text-transform:uppercase;color:var(--gold);font-weight:750;margin-bottom:7px}
.clue p:last-child{margin-bottom:0}
.sep{display:flex;align-items:center;gap:12px;margin:26px 0 23px;color:#ab8b5d}.sep:before,.sep:after{content:"";height:1px;background:var(--line);flex:1}
.note{font-family:Georgia,serif;font-style:italic;font-size:15px;line-height:1.5;color:#ab9a7f;margin-top:21px}
.proof{padding:17px 18px;border:1px solid #b7a07065;background:#b0946020;border-radius:12px;margin-top:29px}
.proof-title{display:flex;align-items:center;gap:9px;color:#ecd1a2;font-size:10px;font-weight:850;letter-spacing:.15em;margin-bottom:9px}.proof-title b{font-size:17px}
.proof p{font-size:12px;line-height:1.75;color:#e1d6c2;margin-bottom:11px}.proof small{color:#a5a192;display:block;line-height:1.55}
.btn{display:inline-flex;justify-content:center;align-items:center;gap:9px;min-height:49px;border:1px solid #a98756;border-radius:8px;padding:12px 16px;background:var(--gold);color:#14161a;font-size:11px;font-weight:850;letter-spacing:.11em;text-transform:uppercase;text-decoration:none;transition:transform .15s,background .15s;max-width:100%;text-align:center}
.btn:active{transform:translateY(1px)}.btn:hover:not(:disabled){background:#e1c493;color:#10131a}
.btn.secondary{background:transparent;color:var(--gold);border-color:#af956e80}.btn.secondary:hover:not(:disabled){background:#b49a6a21;color:var(--warm)}
.btn.quiet{background:#30303938;border-color:#97856c3d;color:#cdc3ae}.btn.full{width:100%}.btn.small{min-height:38px;font-size:10px;letter-spacing:.05em;padding:9px 12px}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.actions>*{flex:1}
.form{margin-top:26px;padding:20px;border:1px solid var(--line);border-radius:13px;background:#0f1216a8}
.form label{display:block;color:#dac7aa;font-size:12px;font-weight:750;letter-spacing:.04em;margin-bottom:13px}
.code-input{width:100%;border:1px solid #8b774d;background:#181c21;border-radius:8px;color:var(--warm);font-size:34px;letter-spacing:.48em;text-indent:.48em;font-weight:550;text-align:center;min-height:66px;margin-bottom:12px;font-variant-numeric:tabular-nums}
.code-input::placeholder{color:#716f66;letter-spacing:.48em}
.input-plain{width:100%;border:1px solid #9b825463;border-radius:8px;background:#10151a;color:var(--warm);padding:15px;min-height:48px;font-size:15px}
.form .hint{font-size:11px;color:var(--muted);margin:8px 0 12px}
.counter{display:flex;justify-content:space-between;gap:10px;align-items:center;font-size:11px;color:#bdad90;margin:0 0 13px}.counter strong{color:var(--gold);font-variant-numeric:tabular-nums}
.feedback{min-height:20px;font-size:12px;line-height:1.5;color:#ecb4a7;margin-top:11px}.feedback.good{color:var(--teal)}
.lock{padding:17px;background:#7e36352b;border:1px solid #bb585a55;color:#ecd3c5;border-radius:9px;margin:12px 0 0;text-align:center;font-size:12px}
.coords{border:1px solid var(--line);background:#0d1217;padding:19px 16px;border-radius:13px;margin:20px 0}
.coords-line{font-size:clamp(19px,3.6vw,28px);font-weight:700;letter-spacing:.01em;white-space:nowrap;color:#e8dfce;font-variant-numeric:tabular-nums;display:flex;align-items:center;gap:2px;margin:13px 0}
.coords-label{font-size:10px;letter-spacing:.13em;text-transform:uppercase;color:#a79d8b;margin-top:6px}
.slot{width:28px;height:38px;min-width:25px;padding:0;background:#27292d;border:1px solid #cfb379;border-radius:5px;color:var(--yellow);text-align:center;font-size:24px;font-weight:750;line-height:34px;font-variant-numeric:tabular-nums;outline-offset:1px}
.slot.green{border-color:#659f85;color:#a6d5b3;background:#142821}.slot.yellow{border-color:#bd9952;color:#eed180;background:#302716}
.slot:focus{background:#3b3021;border-width:2px}
.legend{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
.chip{font-size:11px;padding:6px 9px;border:1px solid;border-radius:5px;font-variant-numeric:tabular-nums}
.chip.yellow{color:var(--yellow);border-color:#d6bd7157;background:#c3a74812}.chip.green{color:var(--teal);border-color:#81b7a052;background:#74bba214}
.box-message{border:1px solid #a6894c64;background:linear-gradient(120deg,#d5ae6c12,#5c201c0c);border-radius:12px;padding:23px;text-align:center;margin:24px 0}
.box-message .big{font:normal 32px Georgia,serif;letter-spacing:.06em;color:var(--gold);margin:8px 0}
.map-coord{text-align:center;padding:23px 15px;margin:25px 0;border:1px solid #c7a46655;background:#bf955911;border-radius:12px}
.map-coord .digits{font-size:clamp(20px,4vw,27px);font-weight:600;color:#f2deb7;letter-spacing:.03em;word-break:break-word}
.reward{width:192px;height:192px;max-width:90%;border:1px solid #cea76b80;box-shadow:0 0 80px #bf884630,inset 0 0 40px #ac85431c;margin:23px auto;display:grid;place-items:center;border-radius:50%;position:relative}
.reward:after{content:"";position:absolute;inset:17px;border:1px dashed #d6b97871;border-radius:50%}
.reward .word{font:normal 41px Georgia,serif;letter-spacing:.1em;color:var(--gold)}
.foot-nav{border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:8px;padding:16px 22px;color:#9b9285;font-size:11px}
.navbtn{border:0;background:transparent;color:#d2b48e;padding:7px;font-size:11px;min-height:37px}
.testpanel{border:1px solid #91654e80;border-radius:11px;padding:15px;background:#7d402c19;margin-top:22px}
.testpanel summary{cursor:pointer;font-size:11px;letter-spacing:.1em;color:#d5a889;font-weight:700}.testpanel ul{padding-left:18px;font-size:12px;color:#d8bdad}
.site-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;color:#77786e;font-size:10px;letter-spacing:.04em;padding-top:20px}.site-foot button{background:transparent;border:0;color:#9d8a6b;font-size:10px;text-decoration:underline}
.welcome-art{border:1px solid var(--line);background:#bda46d0b;padding:17px;text-align:center;margin:25px 0;font:normal 29px Georgia,serif;letter-spacing:.3em;color:#bc9c73}
.toast{position:fixed;bottom:22px;left:50%;transform:translate(-50%,120px);z-index:20;border:1px solid #ad936b;background:#262922;color:var(--warm);padding:13px 20px;max-width:90vw;border-radius:9px;box-shadow:0 14px 35px #0009;transition:transform .25s;font-size:13px;text-align:center;pointer-events:none}.toast.show{transform:translate(-50%,0)}
@media(max-width:800px){.wrap{padding:14px 14px 60px}.top{padding-bottom:12px}.layout{grid-template-columns:1fr;gap:0;padding-top:12px}.aside{position:relative;padding:4px 7px 18px;display:grid;grid-template-columns:1fr 114px;align-items:center;column-gap:12px}.constellation{order:2;height:110px;margin:0;grid-column:2;grid-row:1/5}.constellation:before{width:106px;height:106px}.constellation:after{width:87px;height:87px}.sigil{font-size:63px}.cross{font-size:7px}.aside .eyebrow{grid-column:1;grid-row:1;align-self:end}.aside h1{font-size:clamp(31px,9vw,51px);grid-column:1;grid-row:2;margin:6px 0 10px}.aside p{grid-column:1;grid-row:3;max-width:100%;margin:0;font-size:12px}.edition{display:none}.shell{min-height:420px}.content{padding:22px 19px}.shell-head{padding:17px 19px}.foot-nav{padding:12px 13px}}
@media(max-width:390px){.coords-line{font-size:18px}.slot{width:23px;min-width:22px;height:34px;font-size:20px}.logo{font-size:10px}.top-right{font-size:9px}.actions{flex-direction:column}.aside{grid-template-columns:1fr 84px}.constellation{height:95px}.constellation:before{width:91px;height:91px}.constellation:after{width:74px;height:74px}.sigil{font-size:52px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;scroll-behavior:auto!important;transition:none!important}}
</style>
