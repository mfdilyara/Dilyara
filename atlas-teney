.layout{display:grid;grid-template-columns:minmax(230px,.84fr) minmax(0,1.35fr);gap:clamp(22px,5vw,70px);align-items:start;padding-top:clamp(28px,5vw,60px)}
.aside{position:sticky;top:35px;padding-top:20px}
