<body>
<div class="wrap"><header class="top"><div class="logo">PROSTRANSTVO <span aria-hidden="true">×</span> АТЛАС ТЕНЕЙ</div><div class="top-right">31.10.2026 · ПРОТОТИП</div></header>
<div class="layout">
<aside class="aside" aria-label="Оформление Атласа"><div class="constellation" aria-hidden="true"><span class="cross one">✦</span><span class="cross two">✧</span><span class="sigil">✥</span><span class="cross three">✳</span></div><div class="eyebrow">Охота по Нячангу</div><h1>АТЛАС <span>ТЕНЕЙ</span></h1><p>Город хранит то, что люди забыли. Но не каждый след ведёт туда, куда обещает проводник.</p><div class="edition">PROSTRANSTVO · НОЧНОЙ АРХИВ<br>ПЕЧАТЬ I / 03</div></aside>
<main class="shell" id="app"><div class="shell-head"><div class="shell-title"><span id="page-label">НУЛЕВОЙ ЛИСТ</span><span id="page-count">НАЧАЛО</span></div><div id="progress" class="progress" aria-label="Прогресс прохождения"></div></div><div id="content" class="content" aria-live="polite"></div><nav id="foot-nav" class="foot-nav"></nav></main>
</div><footer class="site-foot"><span>Тестовая версия · Не для реального зачёта</span><button id="toggle-demo">Режим тестирования</button></footer></div><div class="toast" id="toast" role="status"></div>
<script>
(()=>{'use strict';
const KEY='atlas-teney-i-html-v1';
const defaultState=()=>({current:0,unlocked:0,team:'',attempts:{},coord:{},completed:{}});
let state;try{state=Object.assign(defaultState(),JSON.parse(localStorage.getItem(KEY)||'{}'))}catch{state=defaultState()}
let demo=new URLSearchParams(location.search).get('demo')==='1';
let countdownTimer;
const $=sel=>document.querySelector(sel);
const esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(state))}catch{}};
const attemptState=k=>{state.attempts??={};state.attempts[k]??={wrong:0,until:0};return state.attempts[k]};
const minutes=s=>`${String(Math.floor(Math.max(0,s)/60)).padStart(2,'0')}:${String(Math.max(0,s)%60).padStart(2,'0')}`;
function locked(k){const a=attemptState(k);if(a.until && Date.now()>=a.until){a.until=0;a.wrong=0;save()}return a.until>Date.now()}
const toPage=n=>{if(n>state.unlocked||n<0)return;state.current=n;save();render();scrollTo({top:0,behavior:'smooth'})};
function unlock(n){state.unlocked=Math.max(state.unlocked,n);state.current=n;save();render();scrollTo({top:0,behavior:'smooth'});toast('Новый лист Атласа открыт')}
function toast(text){const el=$('#toast');el.textContent=text;el.classList.add('show');clearTimeout(el._t);el._t=setTimeout(()=>el.classList.remove('show'),2500)}
async function copy(text){try{await navigator.clipboard.writeText(text);toast('Скопировано')}catch{const input=document.createElement('textarea');input.value=text;document.body.appendChild(input);input.select();try{document.execCommand('copy');toast('Скопировано')}catch{toast('Выделите и скопируйте текст вручную')}input.remove()}}
const intro=()=>`<span class="kicker">Нулевой лист · Пробуждение</span><h2>Книга, которая помнит дороги</h2><p class="lead">Когда город засыпает, некоторые его знаки начинают говорить.</p><p class="riddle">Перед вами первая печать Атласа. Чтобы найти её, вам придётся исследовать город, восстановить утраченные числа и обнаружить знак, спрятанный от случайных прохожих.</p><div class="welcome-art" aria-hidden="true">✦ &nbsp; I &nbsp; ✦</div><p class="muted" style="font-size:13px">Не закрывайте Атлас раньше времени. Он сохранит уже открытые страницы на этом устройстве.</p><div class="form"><label for="team">Название команды <span class="muted">(необязательно)</span></label><input class="input-plain" id="team" maxlength="50" autocomplete="off" placeholder="Например, Хранители ночи" value="${esc(state.team)}"><div style="height:15px"></div><button class="btn full" id="start">ОТКРЫТЬ АТЛАС <span aria-hidden="true">✧</span></button></div><p class="note">Не всякое важное сообщение будет выглядеть как задание.</p>`;
const proof=(desc,copied)=>`<div class="proof"><div class="proof-title"><b>▣</b> ПОДТВЕРДИТЕ НАХОДКУ</div><p>${desc}</p><p><strong>Без фотографий задание не засчитывается.</strong> Отправьте их Куратору в командный Telegram-чат. Продолжать игру можно, пока организаторы проверяют снимки.</p><button class="btn secondary small" data-copy="${esc(copied)}">СКОПИРОВАТЬ СПИСОК ФОТО</button><small>Командный чат выдаёт организатор. В демо сайт сам не принимает и не проверяет фото.</small></div>`;
const codeform=(stage)=>{const remaining=3-attemptState(stage).wrong;return `<div class="form" id="form-${stage}"><label for="answer-${stage}">Введите три числа в порядке загадок</label><input id="answer-${stage}" class="code-input" inputmode="numeric" pattern="[0-9]*" autocomplete="off" maxlength="3" aria-label="Трёхзначный код" placeholder="•••" ${locked(stage)?'disabled':''}><div class="counter"><span>Попытки для этого листа</span><strong class="attempts-label">${remaining} из 3</strong></div><button id="verify-${stage}" class="btn full" ${locked(stage)?'disabled':''}>ПРОВЕРИТЬ ЗНАКИ</button><div class="feedback" id="feedback-${stage}" role="status"></div><div class="lock" id="lock-${stage}" ${locked(stage)?'':'hidden'}></div></div>`};
const first=()=>`<span class="kicker">Печать I · Часть I</span><h2>По следам забытых знаков</h2><p class="riddle">Когда-то эти земли принадлежали тем, чьи имена давно стёрло время. Но камень помнит больше, чем люди.</p><p class="riddle">Найдите древние башни из красного кирпича, возвышающиеся над городом. Не ищите ответ внутри. То, что вам нужно, осталось за их пределами.</p><p class="riddle">Неподалёку дорога раздваивается, словно змеиный язык. Выберите левый путь и следуйте по узкой улице.</p><div class="statement">Три знака. Три числа. Один путь.</div><div class="clue"><div class="num">Первый знак — по правую руку</div><p class="riddle">Здесь ветер обрёл власть над цветными крыльями. Он заставляет их кружиться, но не может унести с собой.</p><p class="riddle"><strong>Сколько пленников у ветра?</strong></p></div><div class="clue"><div class="num">Второй знак — по левую руку</div><p class="riddle">Там, где люди ищут исцеления, скрывается древний символ единства.</p><p class="riddle">Он родился из соперничества, но стал знаком мира. Его части неразрывны, хотя каждая существует отдельно.</p><p class="riddle"><strong>Сколько фигур образуют этот союз?</strong></p></div><div class="clue"><div class="num">Третий знак — снова справа</div><p class="riddle">Найдите сад, в котором кувшинки никогда не касались воды.</p><p class="riddle">Напротив него поднимите взгляд.</p><p class="riddle">Там застыли молчаливые стражи. Они видели тысячи прохожих, но ни разу не покинули своего поста.</p><p class="riddle"><strong>Сколько стражей охраняют вечный сад?</strong></p></div><div class="sep">✥</div><p class="riddle">Теперь у вас есть три числа.</p><p class="riddle">Запишите их в порядке встречи и передайте Атласу.</p><p class="riddle">Это лишь первая часть координат. Сохраните все найденные числа — каждое из них ещё сыграет свою роль.</p><p class="note">Не всякий, кто находит путь, понимает, куда он ведёт.</p>${proof('Сделайте фотографии всех трёх объектов: цветные ветряки, символ единства возле аптеки, молчаливые стражи.','Печать I — часть I. Фото: 1) цветные ветряки; 2) символ единства возле аптеки; 3) молчаливые стражи.')}${codeform('code1')}`;
const second=()=>`<span class="kicker">Печать I · Часть II</span><h2>Сад ложных знаков</h2><p class="riddle">Первую часть пути вы восстановили. Но Атлас всё ещё скрывает место, где покоится печать.</p><p class="riddle">Вторая строка ждёт там, где странники отправляются в дальний путь.</p><p class="riddle">Неподалёку от остановки есть небольшой зелёный остров. Напротив него птица мира обрела пристанище. Она не летает и не поёт — её имя на чужом языке носит дом, принимающий путешественников.</p><p class="riddle"><strong>Найдите это место.</strong></p><p class="riddle">Здесь город оставил множество знаков. Но лишь три из них принадлежат Атласу.</p><div class="clue"><div class="num">Первый знак — в имени</div><p class="riddle">Некоторые дни исчезают из памяти. Другие остаются на картах навсегда.</p><p class="riddle">Найдите дату, ставшую названием улицы. Сложите числа — так вы получите первое число.</p></div><div class="clue"><div class="num">Второй знак — за оградой</div><p class="riddle">Прямые линии складываются в острые углы. Но среди них скрыты другие фигуры — замкнутые, без начала и конца.</p><p class="riddle">Отыщите их и сосчитайте.</p></div><div class="clue"><div class="num">Третий знак — перед чужими историями</div><p class="riddle">Синий хранитель собрал образы мест, которые видели тысячи людей.</p><p class="riddle">Но ваш знак не среди изображений.</p><p class="riddle">Перед ним стоит тот, кто разгоняет ночную тьму. Он молчит, но носит на себе число.</p><p class="riddle">Найдите его.</p></div><div class="sep">✥</div><p class="riddle"><strong>Три знака. Три числа.</strong></p><p class="riddle">Введите их в Атлас в порядке загадок.</p><p class="riddle">Теперь вернитесь к первой части пути. Все найденные числа понадобятся вам, чтобы восстановить координаты.</p><p class="note">Не всякая дорога ведёт туда, куда обещает проводник.</p>${proof('Отправьте фотографии трёх находок: название улицы с датой, замкнутые фигуры на фасаде за оградой, число на фонарном столбе перед синим стендом.','Печать I — часть II. Фото: 1) название улицы с датой; 2) замкнутые фигуры на фасаде; 3) номер на фонарном столбе перед синим стендом.')}${codeform('code2')}`;
const slot=(id,color)=>`<input class="slot ${color}" data-slot="${id}" inputmode="numeric" pattern="[0-9]*" maxlength="1" value="${esc(state.coord?.[id]||'')}" aria-label="Цифра ${id}">`;
const coords=()=>`<span class="kicker">Печать I · Лист III</span><h2>Восстановление координат</h2><p class="lead">Шесть знаков — одна точка.</p><p class="riddle">Вы нашли две части старой карты. Теперь Атлас требует соединить их. Каждое число должно занять своё место в строках.</p><div class="legend"><span class="chip yellow">Первая часть: 4 · 5 · 2</span><span class="chip green">Вторая часть: 6 · 8 · 3</span></div><div class="coords" role="group" aria-label="Сборка координат"><div class="coords-label">Широта</div><div class="coords-line"><span>12.2</span>${slot('G1','green')}${slot('G2','green')}${slot('Y1','yellow')}<span>1</span>${slot('G3','green')}</div><div class="coords-label">Долгота</div><div class="coords-line"><span>109.</span>${slot('Y3','yellow')}<span>0</span>${slot('Y2','yellow')}<span>364</span></div></div><p class="riddle">Жёлтые пропуски заполняются знаками с первого пути. Зелёные — со второго. Используйте числа в том порядке, в каком нашли их: жёлтые №1, №2, №3 и зелёные №1, №2, №3.</p><div class="form" id="form-coords"><label>Когда обе строки станут целыми, проверьте их</label><div class="counter"><span>Попытки для этого листа</span><strong class="attempts-label">${3-attemptState('coords').wrong} из 3</strong></div><button class="btn full" id="verify-coords" ${locked('coords')?'disabled':''}>ВОССТАНОВИТЬ МАРШРУТ</button><div class="feedback" id="feedback-coords" role="status"></div><div class="lock" id="lock-coords" ${locked('coords')?'':'hidden'}></div></div><p class="muted" style="font-size:11px;margin-top:12px">Это рабочая маска прототипа. Перед реальной игрой необходимо утвердить расположение цветных пропусков.</p>`;
const last=()=>`<span class="kicker">Печать I · Лист IV</span><h2>Последний след</h2><p class="lead">Координаты восстановлены.</p><p class="riddle">Вы собрали разрозненные числа и вернули Атласу утраченную часть карты.</p><p class="riddle">Теперь он знает, куда вас направить.</p><div class="map-coord"><div class="eyebrow">Место, обозначенное Атласом</div><div class="digits">12.268413, 109.205364</div></div><p class="riddle">Но не спешите считать, что цель достигнута.</p><p class="riddle">Там, куда ведут координаты, ваш путь только начинается.</p><p class="riddle">Поднимитесь выше. Оставьте город внизу и ищите знак, который не принадлежит этому месту.</p><p class="riddle">Он не похож на древние письмена. Чёрные и белые квадраты скрывают послание, которое можно прочесть лишь с помощью телефона.</p><p class="riddle">Только тогда первая печать откроет вам свой фрагмент.</p><div class="actions"><a class="btn" href="https://www.google.com/maps/search/?api=1&amp;query=12.268413%2C109.205364" target="_blank" rel="noopener noreferrer">ОТКРЫТЬ В КАРТАХ ↗</a><button class="btn secondary" data-copy="12.268413, 109.205364">СКОПИРОВАТЬ</button></div>${proof('Найдите QR-код, отсканируйте его и отправьте Куратору фотографию знака на месте. Захватите в кадр часть окружения.','Печать I — последний след. Фото: QR-код на месте с частью окружающего пространства.') }<div class="form"><label>Тестирование QR-кода</label><p class="hint">Настоящий QR-код ещё не размещён. Кнопка ниже имитирует сканирование только для проверки прототипа.</p><button class="btn full" id="simulate-qr">◈ СИМУЛИРОВАТЬ QR-СКАНИРОВАНИЕ</button></div>`;
const reward=()=>`<span class="kicker">Печать I · Лист V</span><h2>Печать найдена</h2><p class="lead">Первый фрагмент Атласа открыт.</p><div class="reward" aria-label="Фрагмент: ТЕНЬ"><span class="word">ТЕНЬ</span></div><p class="riddle">Один знак у нас есть. Отличная работа. Запомните его метку: в Атласе ничего не возникает случайно.</p><p class="riddle">Я отправляю вам следующий след. Не задерживайтесь — время работает против нас.</p><div class="proof"><div class="proof-title"><b>✧</b> СОХРАНИТЕ ФРАГМЕНТ</div><p>Отправьте Куратору подтверждения находок. Следующую печать вашей команде выдаст Куратор в Telegram.</p><button class="btn secondary small" data-copy="Печать I: ТЕНЬ">СКОПИРОВАТЬ ФРАГМЕНТ</button></div><div class="actions"><button class="btn quiet" id="reset-inside">НАЧАТЬ ТЕСТ ЗАНОВО</button></div>`;
const pages=[intro,first,second,coords,last,reward];
const pageNames=['Нулевой лист','Следы забытых знаков','Сад ложных знаков','Восстановление координат','Последний след','Фрагмент печати'];
function attempt(key,correct,onSuccess){if(locked(key))return;const a=attemptState(key);if(correct){state.completed[key]=true;save();onSuccess();return}a.wrong++;if(a.wrong>=3)a.until=Date.now()+120000;save();renderAttempt(key);const f=$(`#feedback-${key}`);if(f){f.textContent=a.wrong>=3?'Три неверных ответа. Атлас временно закрылся.':'Атлас не узнаёт эти знаки. Проверьте находки.'} }
function renderAttempt(key){const a=attemptState(key);const isLocked=locked(key);const f=$(`#form-${key}`);if(!f)return;f.querySelector('.attempts-label').textContent=`${Math.max(0,3-a.wrong)} из 3`;const lockBox=$(`#lock-${key}`);if(lockBox){lockBox.hidden=!isLocked;if(isLocked)lockBox.textContent=`Атлас закрыт на ${minutes(Math.ceil((a.until-Date.now())/1000))}. После паузы откроются ещё три попытки.`}const btn=$(`#verify-${key}`);if(btn)btn.disabled=isLocked;const inp=$(`#answer-${key}`);if(inp)inp.disabled=isLocked;f.querySelectorAll('[data-slot]').forEach(el=>el.disabled=isLocked)}
function render(){clearInterval(countdownTimer);const n=Math.min(state.current,state.unlocked,5);state.current=n;$('#page-label').textContent=n===0?'НУЛЕВОЙ ЛИСТ':`ПЕЧАТЬ I · ЛИСТ ${n}`;$('#page-count').textContent=n===0?'ВХОД':`${n} / 5`;$('#progress').innerHTML=Array.from({length:5},(_,i)=>`<span class="${i<n?'done':''}"></span>`).join('');$('#content').innerHTML=pages[n]();$('#foot-nav').innerHTML=`<button class="navbtn" id="go-back" ${n===0?'disabled':''}>← ${n===0?'НАЗАД':'ПРЕДЫДУЩИЙ ЛИСТ'}</button><span>${esc(pageNames[n])}</span>${n<state.unlocked?'<button class="navbtn" id="go-next">ДАЛЕЕ →</button>':''}`;
if(n===1)renderAttempt('code1');if(n===2)renderAttempt('code2');if(n===3)renderAttempt('coords');
if([1,2,3].includes(n))countdownTimer=setInterval(()=>renderAttempt(n===1?'code1':n===2?'code2':'coords'),1000);
if(demo){let panel=document.createElement('details');panel.className='testpanel';panel.innerHTML=`<summary>ДЕМО · Коды и инструменты проверки</summary><ul><li>Первая часть: <strong>452</strong></li><li>Вторая часть: <strong>683</strong></li><li>Цветные ячейки сверху: 6, 8, 4, 3, 2, 5.</li><li>Полные координаты: 12.268413, 109.205364</li><li>Неверный ответ три раза — блокировка на 2 минуты.</li></ul><button class="btn secondary small" id="reset-demo">СБРОСИТЬ ТЕСТ</button>`;$('#content').appendChild(panel)}
save();}
function verifyCode(which){const el=$(`#answer-${which}`);if(!el)return;const val=el.value.replace(/\D/g,'');if(val.length!==3){$(`#feedback-${which}`).textContent='Нужно ввести ровно три цифры.';return}attempt(which,val===(which==='code1'?'452':'683'),()=>unlock(which==='code1'?2:3))}
function verifyCoordinates(){const answer={G1:'6',G2:'8',Y1:'4',G3:'3',Y3:'2',Y2:'5'};const all=Object.keys(answer).every(k=>state.coord[k]&&state.coord[k].length===1);if(!all){$('#feedback-coords').textContent='Заполните все шесть пропусков.';return}const correct=Object.keys(answer).every(k=>state.coord[k]===answer[k]);attempt('coords',correct,()=>unlock(4))}
function reset(){if(!confirm('Сбросить прогресс и все попытки? Начать заново?'))return;state=defaultState();save();render();toast('Атлас готов к новому испытанию')}
const target=new URLSearchParams(location.search);if(target.get('seal')==='I'&&target.get('scan')==='demo'&&state.unlocked>=4){state.current=5;state.unlocked=5}
document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;
if(b.id==='start'){state.team=($('#team')?.value||'').trim();unlock(1)}
else if(b.id==='go-back')toPage(state.current-1);
else if(b.id==='go-next')toPage(state.current+1);
else if(b.id==='verify-code1')verifyCode('code1');
else if(b.id==='verify-code2')verifyCode('code2');
else if(b.id==='verify-coords')verifyCoordinates();
else if(b.id==='simulate-qr')unlock(5);
else if(b.id==='reset-demo'||b.id==='reset-inside')reset();
else if(b.id==='toggle-demo'){demo=!demo;render();toast(demo?'Тестовый режим включён':'Тестовый режим выключен')}
else if(b.hasAttribute('data-copy'))copy(b.getAttribute('data-copy'));
});
document.addEventListener('input',e=>{if(e.target.classList.contains('code-input'))e.target.value=e.target.value.replace(/\D/g,'').slice(0,3);if(e.target.matches('[data-slot]')){e.target.value=e.target.value.replace(/\D/g,'').slice(-1);state.coord[e.target.dataset.slot]=e.target.value;save();if(e.target.value){const slots=[...document.querySelectorAll('[data-slot]')];const idx=slots.indexOf(e.target);if(slots[idx+1])slots[idx+1].focus()}}});
document.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.classList.contains('code-input')){const key=e.target.id.endsWith('code1')?'code1':'code2';verifyCode(key)}if(e.key==='Backspace'&&e.target.matches('[data-slot]')&&!e.target.value){const slots=[...document.querySelectorAll('[data-slot]')];const prev=slots[slots.indexOf(e.target)-1];prev?.focus()}});
render();
})();
</script>
</body></html>
